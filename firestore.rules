rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() { return request.auth != null && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)); }

    match /teachers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /students/{uid} {
      allow read: if true;
      allow create: if isTeacher();
      allow update: if isTeacher() || (request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHomeSeenAt', 'lastScoreboardSeenAt', 'lastDiscussionsSeenAt', 'avatarUrl']));
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /userProfiles/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow write: if true;
    }

    match /classes/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /groups/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /assignments/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /hiddenAssignments/{studentId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    match /submissions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /grades/{id} {
      allow read: if true;
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /discussions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /discussionReplies/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /permissions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /teacherNotifications/{id} {
      allow read, write: if true;
    }

    match /submissionImages/{id} {
      allow read, write: if true;
    }

    match /commentImages/{id} {
      allow read, write: if true;
    }

    match /gradedImages/{id} {
      allow read, write: if true;
    }

    // Thông báo Zalo Bot (email-api/lib/zalo.js). Server ghi qua REST không xác thực nên phải mở như các collection trên;
    // siết luật thì chuyển email-api sang service account.
    // Mã liên kết 6 số do trang học sinh tạo, webhook đổi thành zaloChats rồi xóa.
    match /zaloLinks/{code} {
      allow read, create, delete: if true;
    }
    // zaloChats/<studentId> = { chatId }: chatId chỉ dùng được cùng Bot Token (chỉ server giữ).
    match /zaloChats/{studentId} {
      allow read, write: if true;
    }
    // zaloState/<mã Lần nộp> = { score, sentAt }: lần gửi Thông báo Zalo trước, để chỉ báo phần mới.
    match /zaloState/{submissionId} {
      allow read, write: if true;
    }
  }
}
