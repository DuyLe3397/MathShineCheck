rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() { return request.auth != null && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)); }

    match /teachers/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /students/{uid} {
      allow read: if true;
      allow create: if isTeacher();
      allow update: if isTeacher() || (request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHomeSeenAt', 'lastScoreboardSeenAt', 'lastDiscussionsSeenAt', 'avatarUrl']));
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /userProfiles/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow write: if true;
    }

    match /classes/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /groups/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /assignments/{id} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /submissions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /grades/{id} {
      allow read: if true;
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
      allow write: if isTeacher();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /discussions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /discussionReplies/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /permissions/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /teacherNotifications/{id} {
      allow read, write: if true;
    }

    match /submissionImages/{id} {
      allow read, write: if true;
    }

    match /gradedImages/{id} {
      allow read, write: if true;
    }
  }
}
